{
  "name": "md2pdf",
  "version": "1.0.0",
  "private": true,
  "description": "Offline Markdown to PDF: edit, preview and print to PDF in the browser",
  "keywords": [
    "markdown",
    "pdf",
    "gfm",
    "mermaid",
    "katex",
    "pwa"
  ],
  "homepage": "https://github.com/overklassniy/md2pdf",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest"
  },
