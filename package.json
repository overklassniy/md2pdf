    "codemirror": "^6.0.2",
    "github-markdown-css": "^5.9.0",
    "github-slugger": "^2.0.0",
    "highlight.js": "^11.11.2",
    "katex": "^0.16.47",
    "mdast-util-find-and-replace": "^3.0.2",
    "mdast-util-to-string": "^4.0.0",
    "mermaid": "^11.17.2",
    "normalize.css": "^8.0.1",
    "pagedjs": "^0.4.3",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
